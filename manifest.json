{
  "manifest_version": 3,
  "name": "Dualsub",
  "version": "1.6.0",
  "description": "A second subtitle line in your native language, plus grammar analysis, on Prime Video, ARD Mediathek, ZDF, YouTube and Netflix.",
  "permissions": [
    "storage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://api.ardmediathek.de/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.primevideo.com/*",
        "*://*.amazon.de/*",
        "*://*.amazon.com/*",
        "*://*.ardmediathek.de/*",
        "*://*.zdf.de/*",
        "*://*.youtube.com/*",
        "*://*.netflix.com/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.primevideo.com/*",
        "*://*.amazon.de/*",
        "*://*.amazon.com/*",
        "*://*.ardmediathek.de/*",
        "*://*.zdf.de/*",
        "*://*.youtube.com/*",
        "*://*.netflix.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "dualsub.css"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "key": "",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Dualsub"
  }
}